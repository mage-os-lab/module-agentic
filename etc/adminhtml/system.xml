<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- Under MageOS_Seo's "MageOS SEO" tab, after its own sections. -->
        <section id="mageos_agentic" translate="label" type="text" sortOrder="40"
                 showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Agentic Commerce (UCP)</label>
            <tab>mageos_seo</tab>
            <resource>MageOS_Agentic::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>UCP Profile</label>
                <field id="enabled" translate="label comment" type="select"
                       sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable UCP Profile</label>
                    <comment>Serve /.well-known/ucp, the Universal Commerce Protocol business profile
(UCP 2026-08-25). It declares only the services and capabilities an installed module registers;
with none registered it is valid and declares nothing. Returns 404 when disabled.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <group id="signing" translate="label comment" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Signing Keys</label>
                <comment>Generated by "bin/magento ucp:keygen --website=N". The private key
is stored encrypted; only the public JWK is served, in the profile's "keys".</comment>
                <field id="private_key" translate="label" type="obscure"
                       sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Private Key (encrypted)</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="public_key_jwk" translate="label comment" type="textarea"
                       sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Public Key JWK</label>
                    <comment>Read-only. Populated by the keygen command.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
